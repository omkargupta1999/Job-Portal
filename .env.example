# JobHub configuration. Copy to .env and adjust:  cp .env.example .env
# JobHub never creates or overwrites .env. All values are validated on startup;
# an invalid value stops the app with a clear error (see: docker compose logs).
# After editing this file run `docker compose up -d` - `docker compose restart`
# keeps the old values.

# --- Network -------------------------------------------------------------------
# Host address/port the UI is published on. 127.0.0.1 = reachable only from this
# machine. Read the "Exposing JobHub" section in README.md before changing it.
JOBHUB_HOST=127.0.0.1
JOBHUB_PORT=8080
# Host names the app answers to (DNS-rebinding protection). Add your LAN name/IP
# here if you deliberately expose JobHub, e.g. 127.0.0.1,localhost,jobhub.lan
JOBHUB_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional HTTP Basic authentication. Leave BOTH empty to run without a login
# (fine while JobHub is bound to 127.0.0.1). If you set them: the password needs
# at least 12 characters, and must be wrapped in single quotes if it contains
# '$' or ' #' - Docker Compose otherwise expands/truncates it, e.g.
#   JOBHUB_AUTH_PASSWORD='my$ecret-pass-2026'
# Strongly recommended if JobHub is reachable from other machines.
JOBHUB_AUTH_USER=
JOBHUB_AUTH_PASSWORD=

# --- Synchronisation -------------------------------------------------------------
# 0.5 - 168; can also be changed in Settings
JOBHUB_SYNC_INTERVAL_HOURS=6
# run the first sync automatically after setup
JOBHUB_FETCH_ON_STARTUP=true
# background scheduler on/off
JOBHUB_SCHEDULER_ENABLED=true
# cap per source per run (1 - 10000)
JOBHUB_MAX_JOBS_PER_SOURCE=500
# per HTTP request (1 - 120)
JOBHUB_REQUEST_TIMEOUT_SECONDS=20
# retries for temporary errors (0 - 6), exponential backoff
JOBHUB_MAX_RETRIES=3
# delete expired, never-saved/applied listings after N days (0 = keep)
JOBHUB_EXPIRED_RETENTION_DAYS=60

# --- Sources (no credentials required for any of these) --------------------------
# https://www.arbeitnow.com/api/job-board-api
JOBHUB_SOURCE_ARBEITNOW=true
# https://remotive.com/api/remote-jobs (max 4 fetches/day enforced)
JOBHUB_SOURCE_REMOTIVE=true
# https://jobicy.com/api/v2/remote-jobs (remote jobs, searched with your target titles)
JOBHUB_SOURCE_JOBICY=true
# https://remoteok.com/api (recent remote jobs worldwide)
JOBHUB_SOURCE_REMOTEOK=true

# --- Adzuna: India-wide and international job search (free key) ------------------
# Register at https://developer.adzuna.com and paste the App ID and App Key.
# Without a key the Adzuna source shows "Needs setup" and is skipped.
JOBHUB_ADZUNA_APP_ID=
JOBHUB_ADZUNA_APP_KEY=
# Country codes to search (default: your profile's preferred countries), e.g. in,gb,de,sg,ae
JOBHUB_ADZUNA_COUNTRIES=
# Searches per sync (one per title x country). Adzuna's free limits are not clearly
# published, so keep this modest. The source syncs at most every 12 hours.
JOBHUB_ADZUNA_MAX_QUERIES=8

# --- LinkedIn job-alert emails (optional, experimental) ---------------------------
# JobHub never contacts LinkedIn. Create job alerts on LinkedIn; JobHub reads the
# alert emails from your mailbox (read-only, only from the senders below).
# Gmail: JOBHUB_IMAP_HOST=imap.gmail.com and an App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords). Quote the password with
# single quotes if it contains '$' or ' #'.
JOBHUB_IMAP_HOST=
JOBHUB_IMAP_PORT=993
JOBHUB_IMAP_USER=
JOBHUB_IMAP_PASSWORD=
JOBHUB_IMAP_FOLDER=INBOX
JOBHUB_IMAP_SENDERS=jobalerts-noreply@linkedin.com
# How many days of alert emails to read on each sync (1 - 90)
JOBHUB_IMAP_DAYS=14
# Comma-separated employer board identifiers. Find them in a company's careers URL:
#   Greenhouse: https://boards.greenhouse.io/<token>   -> JOBHUB_GREENHOUSE_BOARDS=<token>
#   Lever:      https://jobs.lever.co/<site>           -> JOBHUB_LEVER_SITES=<site>
#   Lever EU:   https://jobs.eu.lever.co/<site>        -> JOBHUB_LEVER_EU_SITES=<site>
# Boards can also be added on the Job Sources page. Identifiers below are examples
# only - verify the company still uses that platform before relying on them.
JOBHUB_GREENHOUSE_BOARDS=
JOBHUB_LEVER_SITES=
JOBHUB_LEVER_EU_SITES=
#   Ashby:      https://jobs.ashbyhq.com/<board>        -> JOBHUB_ASHBY_BOARDS=<board>
#   SmartRecruiters: https://jobs.smartrecruiters.com/<Company> -> JOBHUB_SMARTRECRUITERS_COMPANIES=<Company>
#   Workable:   https://apply.workable.com/<account>    -> JOBHUB_WORKABLE_ACCOUNTS=<account>
# Easier: use "Find any company's career page" on the Job Sources page.
JOBHUB_ASHBY_BOARDS=
JOBHUB_SMARTRECRUITERS_COMPANIES=
JOBHUB_WORKABLE_ACCOUNTS=

# --- Storage & limits --------------------------------------------------------------
# resume upload limit (1 - 25)
JOBHUB_MAX_UPLOAD_MB=5
# JOBHUB_DATA_DIR is fixed to /data inside the container (Docker volume "jobhub-data").

# --- Logging -----------------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
JOBHUB_LOG_LEVEL=INFO

# --- Outbound proxy (optional; standard variables, honoured by the HTTP client) -----
# HTTPS_PROXY=http://proxy.example.internal:3128
# NO_PROXY=localhost,127.0.0.1
# SSL_CERT_FILE=/data/corp-ca.pem     # custom CA bundle for TLS-intercepting proxies
